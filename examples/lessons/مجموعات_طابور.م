# الطابور: أول من يصل أول من يُخدم
استورد مجموعات

دور = جديد(مجموعات.طابور_من(["ليلى", "عمر"]))
خاتمه حرر(دور)
خاتمه مجموعات.حرر_طابور(محتوى(دور))
مجموعات.ادفع_خلفاً(دور, "هند")
اطبع("في الطابور: ", مجموعات.طول_طابور(محتوى(دور)))
طالما مجموعات.طول_طابور(محتوى(دور)) > 0:
    ز = مجموعات.اسحب_اماماً(دور) والا ""
    اطبع("يُخدم الآن: ", ز)
