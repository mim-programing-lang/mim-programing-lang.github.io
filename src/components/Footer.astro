---
import Default from '@astrojs/starlight/components/Footer.astro';
import { footerNav, navLabel } from '../nav.mjs';
import { site } from '../../site.config.mjs';
import { uiLang, localHref } from '../lib/i18n';
const lang = uiLang(Astro);
const en = lang === 'en';
---

<Default><slot /></Default>
<nav class="site-footer" aria-label={en ? 'Site links' : 'روابط الموقع'}>
  {footerNav.map((l) => <a href={localHref(lang, l.href)}>{navLabel(l.label, lang)}</a>)}
  {en ? (
    <span>All rights reserved, except as granted by the <a href="/en/license/">Meem License</a>.</span>
  ) : (
    <span>جميع الحقوق محفوظة إلا ما تمنحه <a href="/license/">رخصة ميم</a>.</span>
  )}
  <span>{en ? 'Meem — beta' : `${site.name} — ${site.status}`}</span>
</nav>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-block-start: 2rem;
    padding-block-start: 1rem;
    border-block-start: 1px solid var(--sl-color-hairline);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .site-footer a {
    color: var(--sl-color-gray-2);
  }
  .site-footer span:last-child {
    margin-inline-start: auto;
  }
</style>
