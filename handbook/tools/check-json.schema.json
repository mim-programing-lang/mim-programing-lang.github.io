{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "meem --check --json (version 2, tools contract 1)",
 "description": "مخطط خرج الفحص كما في docs/tools-contract.md. يتحقق منه tests/test_docs.py على خرج المجمّع الفعلي.",
 "type": "object",
 "required": ["version", "ok", "file", "path", "summary", "diagnostics", "imports", "files"],
 "properties": {
  "version": {"type": "integer", "enum": [2]},
  "ok": {"type": "boolean"},
  "file": {"type": ["string", "null"]},
  "path": {"type": ["string", "null"]},
  "summary": {
   "type": "object",
   "required": ["errors", "warnings", "deprecated"],
   "properties": {"errors": {"type": "integer"}, "warnings": {"type": "integer"}, "deprecated": {"type": "integer"}}
  },
  "diagnostics": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["file", "path", "severity", "phase", "phase_label", "message", "line", "column", "length", "hint",
                 "notes", "related", "source_line", "deprecated", "advisory"],
    "properties": {
     "file": {"type": ["string", "null"]},
     "path": {"type": ["string", "null"]},
     "severity": {"type": "string", "enum": ["error", "warning"]},
     "phase": {"type": "string", "enum": ["lexical", "syntax", "semantic", "codegen", "internal"]},
     "phase_label": {"type": "string"},
     "message": {"type": "string"},
     "line": {"type": "integer"},
     "column": {"type": "integer"},
     "length": {"type": "integer"},
     "hint": {"type": ["string", "null"]},
     "notes": {"type": "array", "items": {"type": "string"}},
     "related": {
      "type": "array",
      "items": {
       "type": "object",
       "required": ["kind", "line", "column"],
       "properties": {"kind": {"type": "string"}, "file": {"type": ["string", "null"]}, "path": {"type": ["string", "null"]},
                      "line": {"type": "integer"}, "column": {"type": "integer"}}
      }
     },
     "source_line": {"type": ["string", "null"]},
     "deprecated": {"type": ["string", "null"]},
     "advisory": {"type": "boolean"},
     "unsafe": {"type": "string", "enum": ["unsafe-required", "unsafe-disabled", "unsafe-managed"]}
    }
   }
  },
  "imports": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["target", "quoted", "alias", "module", "line", "column", "file", "path", "standard"],
    "properties": {"target": {"type": "string"}, "quoted": {"type": "boolean"}, "alias": {"type": "string"},
                   "module": {"type": "string"}, "line": {"type": "integer"}, "column": {"type": "integer"},
                   "file": {"type": ["string", "null"]}, "path": {"type": ["string", "null"]},
                   "standard": {"type": "boolean"}}
   }
  },
  "files": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["file", "path", "standard", "main"],
    "properties": {"file": {"type": ["string", "null"]}, "path": {"type": ["string", "null"]},
                   "standard": {"type": "boolean"}, "main": {"type": "boolean"}}
   }
  }
 }
}
