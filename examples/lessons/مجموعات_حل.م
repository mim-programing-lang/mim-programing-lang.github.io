# الكلمات المختلفة في جملة، ومربعات زارها لاعب على لوح
استورد مجموعات

هيكل مربع يحقق قابل_للتجزئة:
    صف عدد64
    عمود عدد64

كلمات = تقسيم("ميم لغة سهلة ميم لغة عربية", " ")
مختلفة = مجموعات.مجموعة_من(كلمات)
اطبع("كل الكلمات: ", طول(كلمات), "، والمختلفة: ", مجموعات.طول_مجموعة(مختلفة))

مسار قائمة[مربع] = [مربع(0, 0), مربع(0, 1), مربع(0, 0), مربع(1, 1)]
زارها = مجموعات.مجموعة_من(مسار)
اطبع("مربعات مختلفة: ", مجموعات.طول_مجموعة(زارها))
اطبع("زار (1, 1)؟ ", مجموعات.يحوي_عنصر(زارها, مربع(1, 1)))
اطبع("زار (2, 2)؟ ", مجموعات.يحوي_عنصر(زارها, مربع(2, 2)))
حرر(مسار)
