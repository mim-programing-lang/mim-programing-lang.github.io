---
// ملاحظة الحجز والأداء لكل مدمجة (src/data/builtin-notes.json)، بعنوان لكل منها تحيل إليه صفحة الفهرس.
import { slug } from 'github-slugger';
import notes from '../data/builtin-notes.json';
const entries = Object.entries(notes.notes as Record<string, string>).sort(([a], [b]) => a.localeCompare(b, 'ar'));
---

{entries.map(([name, note]) => (
  <section class="alloc-note">
    <h3 id={slug(name)}><a href={`/docs/stdlib/builtins/#${slug(name)}`}><code>{name}</code></a></h3>
    <p>{note}</p>
  </section>
))}
