# برنامج نظامي صغير: يمشي في شجرة مجلد ويعدّ الملفات والأسطر لكل امتداد (كـ cloc مصغّر)
استورد نظام
استورد ملفات
استورد مسارات
استورد رياضيات

هيكل احصاء:
    امتداد نص
    ملفات عدد
    اسطر عدد
    بايتات عدد

هيكل حصيلة:
    مجلدات عدد
    ثنائية عدد
    ممنوعة عدد

داله سجّل(جدول قائمة[احصاء], فهرس قاموس[نص, عدد], امتداد نص, اسطر عدد, بايتات عدد) فراغ:
    اذا !يوجد(فهرس, امتداد):
        فهرس[امتداد] = طول(جدول)
        اضف(جدول, احصاء(قص(امتداد, 0), 0, 0, 0))   # نسخة: امتداد عرض على مسار سيُحرَّر
    م = فهرس[امتداد]
    ا = جدول[م]
    ا.ملفات += 1
    ا.اسطر += اسطر
    ا.بايتات += بايتات
    جدول[م] = ا

داله امش(مسار نص, جدول قائمة[احصاء], فهرس قاموس[نص, عدد], ح مؤشر[حصيلة], عمق عدد) فراغ:
    اذا عمق > 40:
        ارجع                               # لا طريقة لكشف الروابط الرمزية: حد للعمق بدلها
    اسماء = ملفات.سرد_مجلد(مسار) والا خ:
        حالات خ:
            حاله خطأ.ليس_مجلدا:
                عد_ملف(مسار, جدول, فهرس, ح)
            حاله خطأ.ممنوع:
                محتوى(ح).ممنوعة += 1
            حاله _:
                اطبع("تعذّر: ", مسار, " (", خ, ")")
        ارجع
    خاتمه حرر(اسماء)
    محتوى(ح).مجلدات += 1
    لكل اسم في اسماء:
        اذا يبدأ_بـ(اسم, "."):
            تجاوز
        كامل = مسارات.ضم(مسار, اسم)
        امش(كامل, جدول, فهرس, ح, عمق + 1)
        حرر(كامل)

داله عد_ملف(مسار نص, جدول قائمة[احصاء], فهرس قاموس[نص, عدد], ح مؤشر[حصيلة]) فراغ:
    محتوى_الملف = ملفات.اقرأ_ملف(مسار) والا خ:
        حالات خ:
            حاله خطأ.ليس_نصا:
                محتوى(ح).ثنائية += 1
            حاله خطأ.ممنوع:
                محتوى(ح).ممنوعة += 1
            حاله _:
                اطبع("تعذّر: ", مسار, " (", خ, ")")
        ارجع
    اسطر = 0
    لكل ح_ في محتوى_الملف:
        اذا ح_ == '\n':
            اسطر += 1
    بايتات = طول(محتوى_الملف)          # بالأحرف لا بالبايتات: لا دالة لعدد البايتات
    امتداد = مسارات.الامتداد(مسار)
    اذا طول(امتداد) == 0:
        امتداد = "(بلا)"
    سجّل(جدول, فهرس, امتداد, اسطر, بايتات)
    حرر(محتوى_الملف)

داله قبل(ا احصاء, ب احصاء) منطقي:
    ارجع ا.اسطر > ب.اسطر

و = نظام.وسائط()
البداية = "."
اذا طول(و) > 0:
    البداية = و[0]
جدول قائمة[احصاء] = []
فهرس قاموس[نص, عدد] = {}
ح = جديد(حصيلة(0, 0, 0))
خاتمه حرر(ح)
امش(البداية, جدول, فهرس, ح, 0)
رتب_ب(جدول, قبل)
اطبع("الامتداد       الملفات     الأسطر      الأحرف")
مج_ملفات = 0
مج_اسطر = 0
لكل ا في جدول:
    اطبع(ا.امتداد, "\t", رياضيات.نسق_عدد(ا.ملفات, 8, خطاء), رياضيات.نسق_عدد(ا.اسطر, 11, خطاء), رياضيات.نسق_عدد(ا.بايتات, 12, خطاء))
    مج_ملفات += ا.ملفات
    مج_اسطر += ا.اسطر
اطبع("المجموع: ", مج_ملفات, " ملفاً، ", مج_اسطر, " سطراً، ", محتوى(ح).مجلدات, " مجلداً؛ ثنائية: ", محتوى(ح).ثنائية, "، ممنوعة: ", محتوى(ح).ممنوعة)
