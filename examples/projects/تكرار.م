# أداة سطر أوامر: أكثر الكلمات تكراراً في ملف نصي
# الاستعمال: تكرار <ملف> [عدد_الأوائل]
استورد نظام
استورد ملفات
استورد رياضيات

اخطاء:
    استعمال_خاطئ

هيكل مدخل:
    كلمة نص
    مرات عدد

ثابت علامات = ".،!؟,;:\"()"

داله نظف(كلمة نص) نص:
    # يحذف علامات الترقيم من آخر الكلمة. جزء يرجع عرضاً بلا نسخ، لكن طول ويحوي عليه يحجزان نسخاً لا تُعاد (0.9.1)
    ن = كلمة
    طالما طول(ن) > 0 و يحوي(علامات, جزء(ن, طول(ن) - 1, طول(ن))):
        ن = جزء(ن, 0, طول(ن) - 1)
    ارجع ن

داله قبل(ا مدخل, ب مدخل) منطقي:
    اذا ا.مرات != ب.مرات:
        ارجع ا.مرات > ب.مرات
    ارجع ا.كلمة < ب.كلمة

داله اقرأ_الوسائط() !قائمة[نص]:
    و = نظام.وسائط()
    اذا طول(و) < 1 او طول(و) > 2:
        ارجع خطأ.استعمال_خاطئ
    ارجع و

داله عد_الكلمات(مسار نص, عداد قاموس[نص, عدد]) !عدد:
    سطور = جرّب ملفات.اقرأ_سطور(مسار)
    خاتمه حرر(سطور)
    مجموع = 0
    لكل سطر في سطور:
        قطع = تقسيم(قص_الفراغات(سطر), " ")
        لكل قطعة في قطع:
            ك = نظف(قطعة)
            اذا طول(ك) == 0:
                تجاوز
            مجموع += 1
            اذا يوجد(عداد, ك):
                عداد[ك] = عداد[ك] + 1
            غير ذلك:
                عداد[ك] = 1
        حرر(قطع)
    ارجع مجموع

داله رئيسي() !فراغ:
    و = اقرأ_الوسائط() والا خ:
        اطبع("الاستعمال: تكرار <ملف> [عدد_الأوائل]")
        ارجع خ
    كم = 10
    اذا طول(و) == 2:
        كم = عدد(و[1]) والا خ:
            اطبع("عدد الأوائل ليس عدداً: ", و[1])
            ارجع خ
    عداد قاموس[نص, عدد] = {}
    خاتمه حرر(عداد)
    مجموع = عد_الكلمات(و[0], عداد) والا خ:
        اطبع("تعذّرت قراءة ", و[0], ": ", خ)
        ارجع خ
    مدخلات قائمة[مدخل] = []
    خاتمه حرر(مدخلات)
    لكل ك في مفاتيح(عداد):
        اضف(مدخلات, مدخل(ك, عداد[ك]))
    رتب_ب(مدخلات, قبل)
    اطبع("كلمات: ", مجموع, "، مختلفة: ", طول(عداد))
    لكل ع في مدى(0, رياضيات.اصغر_صحيح(كم, طول(مدخلات))):
        م = مدخلات[ع]
        اطبع(رياضيات.نسق_عدد(ع + 1, 3, خطاء), "  ", رياضيات.نسق_عدد(م.مرات, 8, خطاء), "  ", م.كلمة)

رئيسي() والا خ:
    نظام.انهِ(1)
