# الكومة: آخر ما يدخل أول ما يخرج، كالتراجع في محرر
استورد مجموعات

خطوات = جديد(مجموعات.كومة_من(["كتب «م»", "كتب «ي»"]))
خاتمه حرر(خطوات)
خاتمه مجموعات.حرر_كومة(محتوى(خطوات))
مجموعات.ادفع(خطوات, "حذف سطراً")
اطبع("آخر خطوة: ", مجموعات.اعلى(محتوى(خطوات)) والا "لا شيء")
طالما مجموعات.طول_كومة(محتوى(خطوات)) > 0:
    خ = مجموعات.اسحب(خطوات) والا ""
    اطبع("تراجع عن: ", خ)
