تعداد فصل:
    شتاء
    ربيع
    صيف
    خريف

داله وصف(ف فصل) نص:
    حالات ف:
        حاله فصل.شتاء:
            ارجع "بارد"
        حاله فصل.ربيع:
            ارجع "معتدل"
        حاله فصل.صيف:
            ارجع "حار"
        حاله فصل.خريف:
            ارجع "متقلب"

لكل ف في فصل:
    اطبع(ف, " (", عدد(ف), "): ", وصف(ف))
