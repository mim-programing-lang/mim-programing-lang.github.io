# دالة واحدة لكل نوع: ن معامل نوع يُستنتج من الوسيط
داله اول_او[ن](عناصر قائمة[ن], بديل ن) ن:
    اذا طول(عناصر) == 0:
        ارجع بديل
    ارجع عناصر[0]

اسماء قائمة[نص] = ["سلمى", "خالد"]
فارغة قائمة[عدد64] = []
اطبع(اول_او(اسماء, "لا أحد"))
اطبع(اول_او(فارغة, -1))
اطبع(اول_او([2.5, 4.0], 0.0))
حرر(اسماء)
حرر(فارغة)
