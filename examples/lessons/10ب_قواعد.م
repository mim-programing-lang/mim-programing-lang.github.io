# القاعدة 1: ما تبنيه يُحجز: قائمة، ونص بـ +
اسماء = ["ليلى", "عمر"]
تحية = "أهلاً يا " + اسماء[0]
اطبع(تحية)
# القاعدة 2: حرّر ما انتهيت منه، مرة واحدة
حرر(تحية)
# القاعدة 3: خاتمه تحرّر عند الخروج من الكتلة، بجانب سطر الحجز
خاتمه حرر(اسماء)
لكل ع في مدى(0, 3):
    سطر = "سطر " + نص(ع)
    خاتمه حرر(سطر)
    اطبع(سطر)
