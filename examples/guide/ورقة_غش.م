# برنامج واحد يمرّ على أكثر ما في ورقة الغش
استورد رياضيات

اخطاء:
    فارغة

تعداد مستوى:
    مبتدئ
    متقدم

هيكل طالب:
    اسم نص
    درجات قائمة[عدد]
    مستواه مستوى

داله معدل(ط طالب) !كسر:
    اذا طول(ط.درجات) == 0:
        ارجع خطأ.فارغة
    مج = 0
    لكل د في ط.درجات:
        مج += د
    ارجع كسر(مج) / كسر(طول(ط.درجات))

طلاب = [طالب("ليلى", [90, 85, 100], مستوى.متقدم), طالب("عمر", [], مستوى.مبتدئ)]
خاتمه حرر(طلاب)
عدد_كل قاموس[مستوى, عدد] = {}
خاتمه حرر(عدد_كل)
لكل ط في طلاب:
    م = معدل(ط) والا خ:
        اطبع(ط.اسم, ": لا درجات (", خ, ")")
        تجاوز
    اطبع(ط.اسم, ": ", رياضيات.نسق(م, 1))
    حالات ط.مستواه:
        حاله مستوى.مبتدئ:
            اطبع("  يبدأ")
        حاله مستوى.متقدم:
            اطبع("  متقدم")
لكل ط في طلاب:
    اذا يوجد(عدد_كل, ط.مستواه):
        عدد_كل[ط.مستواه] += 1
    غير ذلك:
        عدد_كل[ط.مستواه] = 1
اطبع("المستويات: ", طول(عدد_كل))
