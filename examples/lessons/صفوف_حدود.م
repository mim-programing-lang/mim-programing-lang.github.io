# حدود قائمة درجات: أصغرها وأكبرها في نداء واحد
داله حدود(درجات قائمة[عدد64]) (اصغر عدد64, اكبر عدد64):
    ص = درجات[0]
    ك = درجات[0]
    لكل د في درجات:
        اذا د < ص:
            ص = د
        اذا د > ك:
            ك = د
    ارجع (ص, ك)

درجات قائمة[عدد64] = [72, 95, 64, 88]
ص, ك = حدود(درجات)
اطبع("أصغر درجة: ", ص, "، وأكبر درجة: ", ك)
ح = حدود(درجات)
اطبع(ح)
اطبع("المدى: ", ح.اكبر - ح.اصغر)
_, اعلى = حدود([3, 9, 5])
اطبع("الأعلى وحده: ", اعلى)
حرر(درجات)
