# الإلحاق في المكان: «ن += ذيل» يكتب في آخر النص نفسه إن لم يمسكه أحد غير المتغير،
# فلا يُنشأ نص جديد في كل دورة. شغّله:  MEEM_RC_REPORT=1 meem 2_الحاق.م --debug-mem
ن = "" + نص(0)                 # نص جديد يملكه المتغير وحده (النص الحرفي لا يُعدَّل)
لكل ع في مدى(0, 20000):
    ن += "ا"                   # عشرون ألف إلحاق في النص نفسه
اطبع(طول(ن))

# حين يمسك النصَّ اسمٌ آخر لا يُمسّ: يُنسخ مرة، ثم يعود الإلحاق في المكان
صورة = ن
ن += "!"
اطبع(طول(صورة), " ", طول(ن))
