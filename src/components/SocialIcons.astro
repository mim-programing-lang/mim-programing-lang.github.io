---
// مكان أيقونات الشبكات في الترويسة (سطح المكتب) يحمل روابط الأقسام.
import Default from '@astrojs/starlight/components/SocialIcons.astro';
import { topNav, navLabel } from '../nav.mjs';
import { uiLang, localHref } from '../lib/i18n';
const lang = uiLang(Astro);
const here = Astro.url.pathname;
---

<nav class="top-nav" aria-label={lang === 'en' ? 'Site sections' : 'أقسام الموقع'}>
  {topNav.map((l) => {
    const href = localHref(lang, l.href);
    return <a href={href} aria-current={here.startsWith(href) ? 'page' : undefined}>{navLabel(l.label, lang)}</a>;
  })}
</nav>
<Default />

<style>
  .top-nav {
    display: flex;
    gap: 1.25rem;
    align-items: center;
    white-space: nowrap;
  }
  .top-nav a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    padding-block: 0.25rem;
    border-block-end: 2px solid transparent;
  }
  .top-nav a:hover {
    color: var(--sl-color-white);
  }
  .top-nav a[aria-current='page'] {
    color: var(--sl-color-white);
    border-block-end-color: var(--meem-red);
  }
</style>
