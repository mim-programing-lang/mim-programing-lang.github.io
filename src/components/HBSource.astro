---
// سطر المصدر: الملف في الكتاب المرجعي وإيداعه.
import hb from '../generated/handbook.json';
import { contentLang } from '../lib/i18n';
interface Props {
  file: string;
}
const { file } = Astro.props;
const en = contentLang(Astro) === 'en';
---

<p class="hb-source">{en ? 'From the reference handbook:' : 'منقول من الكتاب المرجعي:'} <code dir="ltr">docs/handbook/{file}</code> · {en ? 'commit' : 'الإيداع'} <code dir="ltr">{hb.source.commit.slice(0, 7)}</code></p>

<style>
  .hb-source {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    border-inline-start: 3px solid var(--meem-border);
    padding-inline-start: 0.75rem;
  }
</style>
