هيكل كتاب:
    عنوان نص
    صفحات عدد

كتب = [كتاب("الأيام", 160), كتاب("كليلة ودمنة", 290), كتاب("حي بن يقظان", 120)]
مجموع = 0
اطول = كتب[0]
لكل ك في كتب:
    مجموع += ك.صفحات
    اذا ك.صفحات > اطول.صفحات:
        اطول = ك
اطبع("مجموع الصفحات: ", مجموع)
اطبع("أطولها: ", اطول.عنوان, " (", اطول.صفحات, " صفحة)")
حرر(كتب)
