اخطاء:
    عمر_غير_معقول

داله اقرأ_عمر(ن نص) !عدد:
    ع = جرّب عدد(ن)
    اذا ع < 0 او ع > 150:
        ارجع خطأ.عمر_غير_معقول
    ارجع ع

لكل ن في ["30", "ثلاثون", "200"]:
    ع = اقرأ_عمر(ن) والا خ:
        حالات خ:
            حاله خطأ.عمر_غير_معقول:
                اطبع(ن, ": عمر غير معقول")
            حاله _:
                اطبع(ن, ": ليس عدداً (", خ, ")")
        تجاوز
    اطبع(ن, ": العمر ", ع)
