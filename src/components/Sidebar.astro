---
// على الهاتف لا تظهر روابط الترويسة، فتُعرض الأقسام أعلى قائمة الشريط الجانبي.
import Default from '@astrojs/starlight/components/Sidebar.astro';
import { topNav, navLabel } from '../nav.mjs';
import { uiLang, localHref } from '../lib/i18n';
const lang = uiLang(Astro);
const here = Astro.url.pathname;
---

<nav class="section-nav" aria-label={lang === 'en' ? 'Site sections' : 'أقسام الموقع'}>
  {topNav.map((l) => {
    const href = localHref(lang, l.href);
    return <a href={href} aria-current={here.startsWith(href) ? 'page' : undefined}>{navLabel(l.label, lang)}</a>;
  })}
</nav>
<Default><slot /></Default>

<style>
  .section-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-block-end: 1rem;
    margin-block-end: 1rem;
    border-block-end: 1px solid var(--sl-color-hairline);
  }
  .section-nav a {
    padding: 0.3rem 0.9rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    color: var(--sl-color-white);
    text-decoration: none;
    font-size: var(--sl-text-sm);
  }
  .section-nav a[aria-current='page'] {
    border-color: var(--meem-red);
  }
  /* على سطح المكتب الروابط في الترويسة. */
  @media (min-width: 50rem) {
    .section-nav {
      display: none;
    }
  }
</style>
