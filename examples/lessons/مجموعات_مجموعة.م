# المجموعة: عضوية بلا تكرار
استورد مجموعات

زوار = جديد(مجموعات.مجموعة_من(["سلمى", "خالد", "سلمى"]))
خاتمه حرر(زوار)
خاتمه مجموعات.حرر_مجموعة(محتوى(زوار))
اطبع("زوار مختلفون: ", مجموعات.طول_مجموعة(محتوى(زوار)))
مجموعات.اضف_اليها(زوار, "نور")
مجموعات.اضف_اليها(زوار, "خالد")
اطبع("بعد الإضافة: ", مجموعات.طول_مجموعة(محتوى(زوار)))
اطبع("هل زار خالد؟ ", مجموعات.يحوي_عنصر(محتوى(زوار), "خالد"))
اطبع("حُذفت سلمى؟ ", مجموعات.احذف_منها(زوار, "سلمى"))
اطبع("هل زارت سلمى؟ ", مجموعات.يحوي_عنصر(محتوى(زوار), "سلمى"))
