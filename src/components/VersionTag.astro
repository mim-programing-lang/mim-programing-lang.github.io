---
// وسم صغير لصفحة ستتغير مع الإصدار القادم: ما فيها يصف الإصدار المذكور كما قيس، لا ما سيأتي.
interface Props { version?: string }
const { version = '0.9.1' } = Astro.props;
---

<p class="version-tag" role="note"><span>يصف {version}</span> ما في هذه الصفحة مقيس على ميم <bdi dir="ltr">{version}</bdi>، وقد يتغير في إصدار لاحق.</p>

<style>
  .version-tag {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin-block: 0 1.25rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .version-tag span {
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--sl-color-accent);
    color: var(--sl-color-accent-high);
    font-weight: 600;
  }
</style>
