---
// مواصفات ميم: كل بند حقيقة لها مصدر في مستودع المجمّع أو خرجه. الأرقام تُقرأ من خرج المجمّع وقت البناء.
import version from '../generated/version.json';
import language from '../generated/language.json';
import types from '../generated/types.json';
import modules from '../generated/modules.json';
import { site } from '../../site.config.mjs';
import downloads from '../data/downloads.json';
import { mbRound } from '../lib/size.mjs';
import { contentLang } from '../lib/i18n';
const en = contentLang(Astro) === 'en';

// حجم الحزمة لا يُكتب باليد: يُقرأ من قياس الأرشيف في downloads.json (scripts/make-downloads.mjs).
const bundle = (downloads.products as { id: string; bytes: number | null; build: string }[]).find((r) => r.id === 'compiler-linux-x86_64');
const bundleSize = bundle?.bytes ? `نحو ${mbRound(bundle.bytes)} م.ب (الأرشيف المضغوط)` : 'يُكتب حين تُنشر الحزمة';

const typeWords = types.types.map((t) => t.word).join('، ');
const mods = modules.map((m) => `${m.name} (${m.functions.length} دالة)`).join('، ');
const rowsEn: { k: string; v: string; src: string; href?: string }[] = [
  { k: 'Goal', v: 'A standalone executable on Linux x86_64 with the command meem build: static, needing neither Meem nor Python nor LLVM. A direct run (meem ملف.م) remains for quick trials', src: 'docs/build.md, and examples built and run when the site is built', href: '/en/docs/build/' },
  { k: 'Types', v: `Static, checked before running: ${types.types.map((t) => t.word).join(', ')}, and structs`, src: 'meem --list-types', href: '/en/docs/language/types/' },
  { k: 'Memory management', v: 'Since 0.7: allocators and «خاتمه», with no reference counting and no garbage collector; whatever is not freed returns when the program exits. Up to 0.6: reference counting', src: 'The reference handbook: language/08-memory.md, migration/0.6-to-0.7.md', href: '/en/docs/memory/' },
  { k: 'Pointers', v: 'مؤشر[ن] to a slot allocated with جديد and freed by hand with حرر, with no pointer arithmetic; and مؤشر_خام for what comes from C', src: 'docs/pointers.md', href: '/en/docs/language/low-level/' },
  { k: 'Modules', v: 'استورد for a file or a standard module, qualified names, and خاص to hide a definition', src: 'docs/stdlib-design.md', href: '/en/docs/language/modules/' },
  { k: 'Calling C libraries', v: 'The خارجي declaration with explicit C types. Tried with libc and libm', src: 'docs/stdlib-design.md', href: '/en/docs/language/ffi/' },
  { k: 'Standard library', v: `${language.builtins.length} builtin functions, and standard modules: ${modules.map((m) => `${m.name} (${m.functions.length} functions)`).join(', ')}`, src: 'meem --list-keywords, meem --list-module', href: '/en/docs/stdlib/' },
  { k: 'Platforms', v: 'Linux x86_64 only. Windows and macOS are not available in 1.0', src: 'docs/build.md, docs/cli.md', href: '/en/docs/build/#limits' },
  { k: 'Release', v: 'The current download is 0.10 — beta. Meem 0.10.0 is out (a beta before 1.0), and the reference documentation describes it', src: 'downloads.json, and the reference handbook' },
  { k: 'Package size', v: bundle?.bytes ? `about ${mbRound(bundle.bytes)} MB (the compressed archive)` : 'written once the package is published', src: 'measuring the archive (make-downloads)' },
  { k: 'Size of a built program', v: '«مرحبا يا عالم» (hello, world) is about 30 kB static (29640 bytes)', src: 'measured with meem build in 0.10.0', href: '/en/docs/build/' },
  { k: 'Build command', v: 'meem build ملف.م', src: 'docs/build.md', href: '/en/docs/tools/options/' },
];
const rows: { k: string; v: string; src: string; href?: string }[] = [
  { k: 'الهدف', v: 'ملف تنفيذي مستقل على لينكس x86_64 بالأمر meem build: ساكن، لا يحتاج ميم ولا بايثون ولا LLVM. والتشغيل المباشر (meem ملف.م) يبقى للتجربة السريعة', src: 'docs/build.md، وأمثلة تُبنى وتُشغَّل عند بناء الموقع', href: '/docs/build/' },
  { k: 'الأنواع', v: `ثابتة، تُفحص قبل التنفيذ: ${typeWords}، والهياكل`, src: 'meem --list-types', href: '/docs/language/types/' },
  { k: 'إدارة الذاكرة', v: 'منذ 0.7: مخصصات و«خاتمه»، بلا عدّ مراجع ولا جامع قمامة؛ ما لا يُحرَّر يعود عند خروج البرنامج. حتى 0.6: عدّ مراجع', src: 'الكتاب المرجعي: language/08-memory.md، migration/0.6-to-0.7.md', href: '/docs/memory/' },
  { k: 'المؤشرات', v: 'مؤشر[ن] إلى خانة تُحجز بـ جديد وتُحرَّر يدوياً بـ حرر، بلا حسابات على العناوين؛ ومؤشر_خام لما يأتي من C', src: 'docs/pointers.md', href: '/docs/language/low-level/' },
  { k: 'الوحدات', v: 'استورد لملف أو لوحدة قياسية، وأسماء مؤهَّلة، وخاص لإخفاء تعريف', src: 'docs/stdlib-design.md', href: '/docs/language/modules/' },
  { k: 'الاتصال بمكتبات C', v: 'التصريح خارجي بأنواع C صريحة. جُرّب مع libc وlibm', src: 'docs/stdlib-design.md', href: '/docs/language/ffi/' },
  { k: 'المكتبة القياسية', v: `${language.builtins.length} دالة مدمجة، ووحدة قياسية: ${mods}`, src: 'meem --list-keywords، meem --list-module', href: '/docs/stdlib/' },
  { k: 'المنصات', v: 'لينكس x86_64 وحده. ويندوز وماك غير متاحين في 1.0', src: 'docs/build.md، docs/cli.md', href: '/docs/build/#الحدود' },
  { k: 'الإصدار', v: `التنزيل الحالي 0.10 — ${site.status}. صدرت 0.10.0 (تجريبية قبل 1.0)، والوثائق المرجعية تصفها`, src: 'downloads.json، والكتاب المرجعي' },
  { k: 'حجم الحزمة', v: `${bundleSize}`, src: 'قياس الأرشيف (make-downloads)' },
  { k: 'حجم البرنامج المبني', v: '«مرحبا يا عالم» ساكناً نحو 30 ك.ب (29640 بايتاً)', src: 'قياس بـ meem build في 0.10.0', href: '/docs/build/' },
  { k: 'أمر البناء', v: 'meem build ملف.م', src: 'docs/build.md', href: '/docs/tools/options/' },
];
---

<section class="specs" aria-labelledby="specs-title">
  <h2 id="specs-title">{en ? 'Meem at a glance' : 'مواصفات ميم'}</h2>
  <table>
    <thead>
      <tr><th scope="col">{en ? 'Item' : 'البند'}</th><th scope="col">{en ? 'Description' : 'الوصف'}</th><th scope="col">{en ? 'Source' : 'المصدر'}</th></tr>
    </thead>
    <tbody>
      {(en ? rowsEn : rows).map((r) => (
        <tr>
          <th scope="row">{r.href ? <a href={r.href}>{r.k}</a> : r.k}</th>
          <td><span class="v">{r.v}</span></td>
          <td class="src"><span class="v">{r.src}</span></td>
        </tr>
      ))}
    </tbody>
  </table>
</section>

<style>
  .specs {
    margin-block-start: 2rem;
  }
  .specs h2 {
    font-size: var(--sl-text-h3);
    margin-block-end: 1rem;
    color: var(--sl-color-white);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    display: table;
  }
  th,
  td {
    text-align: start;
    vertical-align: top;
    padding: 0.6rem 0.75rem;
    border-block-end: 1px solid var(--sl-color-hairline);
  }
  thead th {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  tbody th {
    white-space: nowrap;
    font-weight: 600;
  }
  .v {
    unicode-bidi: plaintext;
    display: block;
    text-align: right;
  }
  .src {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  @media (max-width: 40rem) {
    thead {
      display: none;
    }
    tr {
      display: block;
      padding-block: 0.6rem;
      border-block-end: 1px solid var(--sl-color-hairline);
    }
    th,
    td {
      display: block;
      padding: 0.1rem 0;
      border: 0;
    }
  }
</style>
